    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const response = $input.first().json;\nconst places = Array.isArray(response.local_results) ? response.local_results : [];\n\nfunction text(value) {\n  return typeof value === \"string\" ? value.trim() : \"\";\n}\n\nfunction numberOrBlank(value) {\n  if (typeof value === \"number\" && Number.isFinite(value)) return value;\n  if (typeof value === \"string\" && value.trim() !== \"\" && Number.isFinite(Number(value))) {\n    return Number(value);\n  }\n  return \"\";\n}\n\nfunction hoursOf(place) {\n  const hours = text(place.hours);\n  if (hours) return hours;\n  const openState = text(place.open_state);\n  if (openState) return openState;\n  if (place.operating_hours && typeof place.operating_hours === \"object\") {\n    return Object.entries(place.operating_hours)\n      .filter((entry) => typeof entry[1] === \"string\" && entry[1].trim())\n      .map(([day, value]) => day + \": \" + value.trim())\n      .join(\"; \");\n  }\n  return \"\";\n}\n\nfunction linkOf(place) {\n  const website = text(place.website);\n  if (website) return website;\n  const gps = place.gps_coordinates || {};\n  if (typeof gps.latitude === \"number\" && typeof gps.longitude === \"number\") {\n    return \"https://www.google.com/maps/search/?api=1&query=\" + gps.latitude + \",\" + gps.longitude;\n  }\n  return \"\";\n}\n\nreturn places\n  .filter((place) => place && text(place.title))\n  .map((place) => ({\n    json: {\n      name: text(place.title),\n      rating: numberOrBlank(place.rating),\n      reviews: numberOrBlank(place.reviews),\n      type: text(place.type),\n      address: text(place.address),\n      phone: text(place.phone),\n      hours: hoursOf(place),\n      link: linkOf(place),\n    },\n  }));\n"
      },
